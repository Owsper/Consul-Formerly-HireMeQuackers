# ---------------------------------------------------------------------------
# consul configuration. Copy to `.env` and fill in what you need.
# Every value below is OPTIONAL except DATABASE_URL has a sane default.
# Secrets are read from the environment only and are never written to SQLite.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# The app routes each kind of work automatically. You do not select a model.
# Gemini handles extraction and high-stakes CV reasoning; Groq handles
# high-volume drafting and planning. Configure one or both keys.
GROQ_API_KEY=
GEMINI_API_KEY=

# Every route has an ordered fallback chain. If a provider returns 429, pause it
# for this many seconds before trying again.
LLM_COOLDOWN_SECONDS=180

# Optional route overrides: provider:model,provider:model
# LLM_ROUTE_EXTRACTION=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b
# LLM_ROUTE_REASONING=gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite
# LLM_ROUTE_WRITING=groq:openai/gpt-oss-120b,gemini:gemini-3.8-flash
# LLM_ROUTE_PLANNING=groq:openai/gpt-oss-120b,gemini:gemini-3.8-flash
# LLM_ROUTE_UTILITY=groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite

# Legacy single-provider fallback for custom installations: groq | gemini |
# openai | openrouter | deepseek | mistral | cerebras | zai | ollama | custom
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
# Only needed for `custom`, or to override a preset's endpoint.
LLM_BASE_URL=

# Hard request timeout and global output cap. Keep the timeout low so a stalled
# call fails fast instead of blocking the UI. Individual routes apply a lower
# cap for Groq so one response cannot consume its whole per-minute budget.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=8192
# Optional reasoning cap for legacy Groq/OpenRouter models: low | medium | high.
LLM_REASONING_EFFORT=
# Set to 0 to run fully offline (rule-based CV generation, no AI planning).
LLM_ENABLED=1

# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///data/consul.db
DATA_DIR=data
MAX_UPLOAD_MB=10

# --- Scanning / networking -------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
MAX_CONCURRENCY=8
PER_SOURCE_CONCURRENCY=3
USER_AGENT=consul/1.0 (personal job search assistant; contact: you@example.com)
# Optional: explicit LibreOffice binary for DOCX→PDF conversion
CONSUL_SOFFICE=

# --- Job aggregators (optional, require free registration) -----------------
# https://developer.adzuna.com/  (free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=de
# https://jooble.org/api/about (free API key on request)
JOOBLE_API_KEY=

# --- Search engine discovery (optional) ------------------------------------
# Provider: none | brave | serper | tavily
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# --- Default ATS board identifiers (comma separated) -----------------------
# Used as seeds for company discovery when no registry entries exist yet.
# Optionally prefix a display name: "Acme:acme".
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ASHBY_BOARDS=
SMARTRECRUITERS_COMPANIES=
WORKABLE_ACCOUNTS=
RECRUITEE_COMPANIES=
PERSONIO_COMPANIES=
# Format: tenant/site@host, e.g. acme/External@acme.wd1.myworkdayjobs.com
WORKDAY_TENANTS=
# Format: Company:subdomain (or a full careers URL)
TEAMTAILOR_SITES=
